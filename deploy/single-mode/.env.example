# ================================================
#    ENV VARIABLES FOR SINGLE MODE & MONITORING
# ================================================

# -------- DOMAIN & FQDN --------
DOMAIN=example.com
SUBDOMAIN_N8N=n8n
SUBDOMAIN_GRAFANA=grafana
SUBDOMAIN_PROMETHEUS=prometheus
SSL_EMAIL=you@example.com
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

N8N_FQDN=${SUBDOMAIN_N8N}.${DOMAIN}
GRAFANA_FQDN=${SUBDOMAIN_GRAFANA}.${DOMAIN}
PROMETHEUS_FQDN=${SUBDOMAIN_PROMETHEUS}.${DOMAIN}

# -------- IMAGE & RUNTIME --------
N8N_IMAGE_TAG=2.17.7
NODE_ENV=production
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# -------- n8n URLS --------
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=${N8N_FQDN}
WEBHOOK_URL=https://${N8N_FQDN}
N8N_EDITOR_BASE_URL=https://${N8N_FQDN}
N8N_PUBLIC_API_BASE_URL=https://${N8N_FQDN}
N8N_SECURE_COOKIE=true

# -------- SECURITY & SECRETS --------
# Replace all CHANGE_ME* with secure values!

# Generate with: openssl rand -base64 16
POSTGRES_PASSWORD=CHANGE_ME_BASE64_16_BYTES
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# -------- INSTANCE OWNER --------
# n8n removed basic auth in 1.0; user management replaced it. To create the
# owner account from the environment instead of clicking through the setup
# screen, set these (n8n_manager.sh --owner-email/--owner-password fills them
# in for you and does the hashing).
#
# The password must be a PRE-HASHED bcrypt string ($2a/$2b/$2y, cost 2 digits,
# 60 chars total) - n8n rejects anything else. Note that n8n re-applies these
# on every boot, so a password changed in the UI is overwritten on restart.
# N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
# N8N_INSTANCE_OWNER_EMAIL=you@example.com
# N8N_INSTANCE_OWNER_PASSWORD_HASH=
# N8N_INSTANCE_OWNER_FIRST_NAME=Instance
# N8N_INSTANCE_OWNER_LAST_NAME=Owner

# -------- DATABASE SETTINGS --------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

POSTGRES_USER=n8n
POSTGRES_DB=n8n

# -------- RUNNERS (internal) --------
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
N8N_RUNNERS_MAX_CONCURRENCY=5

# -------- FILE ACCESS SECURITY --------
N8N_RESTRICT_FILE_ACCESS_TO=/files

# -------- EXECUTION BEHAVIOR --------
# Single mode:
EXECUTIONS_MODE=regular

# Save large binary file to disk volume Docker under /home/node/.n8n/binaries/
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_RETRY_MAX=3

# -------- MONITORING STACK --------
COMPOSE_PROJECT_NAME=n8n
# Enable monitoring stack: set to "monitoring"
# E.g.: COMPOSE_PROFILES=monitoring
COMPOSE_PROFILES=
TRAEFIK_USERSFILE=/etc/traefik/htpasswd

# Grafana admin password and Traefik's Basic Auth
MONITORING_BASIC_AUTH_USER=admin
# Generate with: openssl rand -base64 16
MONITORING_BASIC_AUTH_PASS=CHANGE_ME_BASE64_16_BYTES

# Expose Prometheus
EXPOSE_PROMETHEUS=false

# -------- END OF CONFIG --------
